{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://agentsoc.local/schemas/agent_input.json",
  "title": "AgentInput",
  "type": "object",
  "required": [
    "incident_id",
    "title",
    "created_at",
    "initial_severity",
    "entities",
    "events"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "initial_severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "entities": {
      "type": "object",
      "required": ["hosts", "users", "ip_addresses"],
      "properties": {
        "hosts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "users": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ip_addresses": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "security_event.json"
      }
    }
  },
  "additionalProperties": false
}
